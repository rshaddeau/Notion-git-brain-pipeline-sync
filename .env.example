# Copy this file to .env and fill in real values for local testing.
# .env is gitignored - never commit it. In production these same names are
# set as GitHub Actions secrets instead (see README.md's Prerequisites and
# Setup Walkthrough sections).

# Notion internal integration token ("connection" in current Notion UI
# terminology). Create it at Settings -> Connections in your Notion
# workspace, then explicitly share your root export page with it - sharing
# is what actually enforces export scope, not anything in export.js. The
# token string starts with "ntn_".
NOTION_TOKEN=ntn_replace_with_your_real_token

# Placeholder - replace with the page ID of the Notion page you want to use
# as your export root (e.g. a top-level "Docs" or "Projects" page). Find it
# in the page URL: notion.so/Your-Page-Title-<32 hex characters>. The ID is
# those 32 hex characters; Notion accepts it with or without dashes.
NOTION_ROOT_PAGE_ID=00000000000000000000000000000000
